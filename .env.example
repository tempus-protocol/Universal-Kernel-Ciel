# Tempus Guard CLI reads these when the matching flag is not given to `tempus guard intent`.
TEMPUS_TENANT_ID=acme
TEMPUS_AGENT_KEYFILE=agent.keys.json
# owner/repository; default: parsed from the GitHub remote URL
TEMPUS_RESOURCE=owner/repository
# the commit GitHub has, that the branch builds on
TEMPUS_BASE=origin/main
TEMPUS_REMOTE=origin
# set to 1 only for a deliberate direct push past the pre-push hook
# TEMPUS_GUARD_ALLOW_DIRECT_PUSH=1
